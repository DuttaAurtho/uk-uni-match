GEMINI_API_KEY=

# Free-tier quota is per model, not per key. The newest models have the
# tightest limits (gemini-3.6-flash allows only 20 requests/day), so if
# searches start falling back to estimated data with a 429 RESOURCE_EXHAUSTED
# in the logs, switching this to another model gives you a fresh allowance.
GEMINI_MODEL=gemini-3.5-flash

# Optional. Comma-separated extra origins allowed to call this API, on top of
# localhost and *.vercel.app. Set this if the frontend is hosted elsewhere.
# CORS_ORIGINS=https://example.com,https://www.example.com
