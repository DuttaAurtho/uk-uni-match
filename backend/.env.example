# Which model backend to use: gemini | claude
LLM_PROVIDER=gemini

# --- Gemini (free tier) ---------------------------------------------------
# Free-tier quota is per model, not per key. The newest models have the
# tightest limits (gemini-3.6-flash allows only 20 requests/day), so if
# searches start falling back to estimated data with a 429 RESOURCE_EXHAUSTED
# in the logs, switching models gives you a fresh allowance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Claude (pay-per-use, no daily cap) -----------------------------------
# Only needed when LLM_PROVIDER=claude. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=

# Optional. Overrides the active provider's default model.
# Claude default is claude-opus-5. Rough cost per search (~5k in / ~2k out):
#   claude-haiku-4-5  ~$0.015   claude-sonnet-5  ~$0.030   claude-opus-5  ~$0.075
# LLM_MODEL=claude-haiku-4-5

# Optional, Claude only: low | medium | high | xhigh | max (default low).
# This workload is extraction from snippets we supply, so low is usually
# enough; raise it if the returned figures get sloppy.
# LLM_EFFORT=low

# --- API ------------------------------------------------------------------
# Optional. Comma-separated extra origins allowed to call this API, on top of
# localhost and *.vercel.app. Set this if the frontend is hosted elsewhere.
# CORS_ORIGINS=https://example.com,https://www.example.com

# Set to "production" on the deployed backend. Controls the session cookie's
# Secure/SameSite attributes (see deps.cookie_kwargs) — cross-site cookies
# between the Vercel frontend and this API need SameSite=None; Secure, which
# only works over HTTPS, so local dev needs this left as "development".
ENV=development

# --- Accounts / sessions ---------------------------------------------------
# Any long random string; signs the session JWT. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Email (OTP verification + password reset) -----------------------------
# Gmail SMTP with an App Password (not your normal Gmail password) —
# generate one at https://myaccount.google.com/apppasswords (requires 2FA
# enabled on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Admin account (scripts/create_admin.py) --------------------------------
# Only read by that script, never by the running app. Run the script once
# after setting these; the password is bcrypt-hashed before it's stored, and
# these two values can be blanked out again afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
# Optional. Without these, db.py uses a local universities.db file (fine for
# dev, but wiped on every deploy on hosts with an ephemeral filesystem). Set
# both to point at a free Turso (libSQL) database instead, so data survives
# redeploys: https://turso.tech -- `turso db create <name>`, then
# `turso db show <name> --url` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
